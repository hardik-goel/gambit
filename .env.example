# Gambit runs with none of these set: the dev server is the table, backed by an
# in-process store and an SSE fan-out. Fill them in and the same pipeline runs
# on Postgres and Realtime instead — see apps/web/lib/server/supabase.ts.

# Supabase project (region ap-south-1 for the launch market)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Moves are written by the service role and never by a client:
# this key must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Only when the Supabase project is shared with another product: keeps every
# Gambit table in a schema of its own instead of `public`. Must match what
# `pnpm db:migrate` was run with, and be listed under Settings → API →
# Exposed schemas. Leave unset for a project that is Gambit's own.
# GAMBIT_DB_SCHEMA=gambit
